car


car_labels = Y_train


## use oneHotEncoder on brand ,fuel_type , transmission , ownership 
#make pipe line for encoder 


from sklearn.pipeline import Pipeline
from sklearn.preprocessing import OneHotEncoder
from sklearn.preprocessing import StandardScaler
from sklearn.compose import ColumnTransformer


encoder_pipeline = Pipeline([
    ("onehot", OneHotEncoder(handle_unknown="ignore"))
])



scaler_pipeline = Pipeline([
    ("scaler" , StandardScaler())
])


final_pipeline = ColumnTransformer([
    ("encoder", encoder_pipeline, ["fuel_type", "brand","transmission", "ownership"]),
    ("scaler", scaler_pipeline, ["manufacture", "kms_driven", "engine","Seats"])
])


final_pipeline



car_prepared = final_pipeline.fit_transform(car)


car_prepared





